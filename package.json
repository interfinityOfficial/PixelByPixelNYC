{
  "name": "pixelbypixel",
  "version": "1.0.0",
  "description": "Pixel by Pixel NYC — Cloudflare Workers + D1 + R2",
  "license": "ISC",
  "author": "",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply pixelbypixel --local",
