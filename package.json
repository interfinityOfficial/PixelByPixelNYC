    "db:import:remote": "node scripts/import-d1.mjs --remote",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.2.2",
    "hono": "^4.9.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "wrangler": "^4.28.0"
  }
