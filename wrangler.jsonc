{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pixelbypixel",
	"main": "src/index.js",
	"compatibility_date": "2026-08-07",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		// Run Worker first so /, /login/, /dashboard/ are dynamic (not static 404s)
		"run_worker_first": true
	},
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.html"
			],
			"fallthrough": true
		}
	],
	"vars": {
		"RP_ID": "pixelbypixel.nyc",
		"RP_NAME": "Pixel by Pixel NYC",
		// CDN maps URL path → object key. Existing objects live under the "storage/" prefix.
		"R2_PUBLIC_URL": "https://cdn.pixelbypixel.nyc"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pixelbypixel-db",
			"database_id": "8e4f2f40-b228-4d48-a4d7-f32b51ffa0f5",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "storage"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "ab5325bdcf1b43cea7913ea0faea1b3e"
		}
	],
	"observability": {
		"enabled": true
	}
}